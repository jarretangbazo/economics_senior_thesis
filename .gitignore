# =============================================================================
# .gitignore — Education Under Fire
#
# Allow-list: only the code, the outputs, the README and renv.lock are committed.
# Everything else in the project root (data/, docs/, environments, R project
# files) stays local.
# =============================================================================

/*
!/.gitignore
!/README.md
!/renv.lock
!/code/
!/output/

# docs/ is local only (thesis drafts, feedback, notes)
docs/

# =============================================================================
# Inside code/ and output/
# =============================================================================

# Run logs written by master.sh
output/logs/

# Safety net: never commit data files, even if one lands in code/ or output/
# (DHS and ACLED distribution is license-restricted)
*.csv
*.CSV
*.dta
*.DTA
*.parquet
*.rds
*.zip
*.shp
*.shx
*.dbf
*.prj

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# R
.Rhistory
.RData

# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz
*.toc

# OS / editor
.DS_Store
*.swp
*~
~$*
